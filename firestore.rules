rules_version = '2';

// Modèle :
//   users/{uid}                         → { householdId, email, displayName }
//   households/{hid}                    → { name, members[], memberNames{}, currentPlanId }
//   households/{hid}/plans/{planId}     → menu + liste de courses (items{})
//   households/{hid}/recipes/{rid}      → recettes perso du foyer
//
// L'identifiant du foyer sert de code d'invitation : il est aléatoire (20 caractères)
// et la liste des foyers n'est jamais lisible, donc seul qui reçoit le code peut rejoindre.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /households/{hid} {
      // Lecture d'un foyer précis (nécessaire pour vérifier un code d'invitation).
      allow get: if signedIn();
      allow list: if false;

      // Création : on ne peut créer qu'un foyer dont on est l'unique membre.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];

      allow update: if isMember(hid)
        // Rejoindre avec le code : on ne peut que s'ajouter soi-même, rien d'autre.
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
            && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]));

      allow delete: if false;

      // Menus, listes et recettes perso : réservés aux membres du foyer.
      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
